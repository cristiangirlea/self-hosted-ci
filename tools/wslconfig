# Written to %USERPROFILE%\.wslconfig by `make wsl-cap`. Takes effect after `wsl --shutdown`.
#
# These are ceilings, not allocations: the WSL virtual machine (which Docker Desktop and the
# cluster run in) takes memory as it is needed and, with autoMemoryReclaim, gives idle memory
# back to Windows. Per-application sizing happens inside Kubernetes (requests, limits, quotas),
# not here. Raise the ceiling only if the cluster shows pressure (`kubectl top nodes`).
#
# WSL reads autoMemoryReclaim and sparseVhd only under [experimental] (2.6 ignores them under
# [wsl2]). dropCache releases the page cache once the VM goes idle; a VM running CI rarely does,
# so `make wsl-cache-task` also drops it every 15 minutes.
[experimental]
autoMemoryReclaim=dropCache
sparseVhd=true

# WSL_MEMORY, WSL_PROCESSORS and WSL_SWAP_FILE in the config replace these per machine; swapFile
# is appended, so [wsl2] stays the last section.
[wsl2]
memory=24GB
processors=16
